#!/bin/sh
# crew-title <word>: say what the seat is on, in the tab (tmux window name <seat>:<word>) and in the Remote
# Control label (<session>:<word>, the session name crew-wake gave, in CREW_SESSION). crew-wake sets <seat>:new,
# the seat sets its work word when it starts on a bead, and only the handoff skill sets handoff (PRIME.md, "Titles").
word=$1
if [ -z "$word" ] || [ -z "$SEAT" ]; then
  echo "usage: crew-title <word>, inside a session started by crew-wake (it sets SEAT and CREW_SESSION)"
  exit 1
fi
if [ "$word" = handoff ] && [ -z "$CREW_HANDOFF" ]; then
  echo "crew-title: handoff is the handoff skill's word, set in /crew:handoff when the user has asked for the handoff. Closing a bead or delivering a report is not a handoff: keep your work word."
  exit 1
fi
fallback="Remote Control label not changed; ask the user to run: /rename ${CREW_SESSION:-<session>}:$word"
if [ -z "$TMUX_PANE" ]; then echo "$fallback"; exit 0; fi
tmux rename-window -t "$TMUX_PANE" "$SEAT:$word"
# /rename is the only road to the Remote Control label a session can take itself: type it into this session's
# own input, unless a draft of the user's sits there. The last '❯' line of the pane is the input box; empty,
# it holds a no-break space (or a 'Try "..."' placeholder before the first prompt).
# ponytail: screen scraping; if the prompt glyph ever changes, the fallback below prints the /rename line.
nbsp=$(printf '\302\240')
if [ -z "$CREW_SESSION" ] || ! tmux capture-pane -p -t "$TMUX_PANE" | grep '^❯' | tail -n 1 | grep -q -E "^❯[ $nbsp]*(Try \".*)?\$"; then
  echo "tab $SEAT:$word"; echo "$fallback"; exit 0
fi
tmux send-keys -t "$TMUX_PANE" -l "/rename $CREW_SESSION:$word"
tmux send-keys -t "$TMUX_PANE" Enter
# The typed line was lost once (ck-hy9): claim the label only once the session registry shows it.
reg=$(grep -l "\"name\":\"$CREW_SESSION[:\"]" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/sessions/*.json 2>/dev/null | head -n 1)
if [ -z "$reg" ]; then echo "tab $SEAT:$word, label $CREW_SESSION:$word typed (no session registry to confirm it)"; exit 0; fi
for i in 1 2 3 4 5 6; do
  # the current name only: formerNames in the same file holds every word the session had before
  [ "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$reg" 2>/dev/null)" = "$CREW_SESSION:$word" ] \
    && { echo "tab $SEAT:$word, label $CREW_SESSION:$word"; exit 0; }
  sleep 1
done
echo "tab $SEAT:$word"; echo "$fallback"
